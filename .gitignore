/target/
**/*.rs.bk

# Local editor and OS files
.DS_Store
.idea/
.vscode/

# Local environment files
.env
.env.*
!.env.example
# Frontend build product (embedded by lure-desktop)
frontend/dist

# Frontend (自有 shadcn/Tailwind v4 WebUI，构建产物输出到 frontend/dist)
frontend/app/node_modules/
frontend/app/*.tsbuildinfo
frontend/app/coverage/

# Tauri build 生成物（tauri-build 编译期生成 schema/context）
crates/lure-desktop/gen/

# E2E (Playwright 契约测试)
e2e/node_modules/
e2e/.workspace/
e2e/test-results/
e2e/playwright-report/
e2e/.playwright/
